<Window x:Class="Diver_RaT.LinuxPayloadCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Diver_RaT"
        Title="Linux Agent Creator" Height="560" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource WindowBgBrush}"
        Foreground="#E6E8EF">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6ACBF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="1" ResizeBorderThickness="6"
                      CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:CustomTitleBar Grid.Row="0" Title="Linux Agent Creator"/>
        <Grid Grid.Row="1" Background="{StaticResource WindowBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource HeaderGlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" CornerRadius="4"
                            Background="{StaticResource LimeBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Linux Agent Creator" FontSize="16" FontWeight="Bold" Foreground="{StaticResource LimeBrush}"/>
                        <TextBlock Text="Generate a Python 3 agent script that connects back to this controller over TCP"
                                   FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20" VerticalAlignment="Center">
                <TextBlock Text="LISTENER (CONTROLLER)" Style="{StaticResource FieldLabelStyle}" FontWeight="SemiBold" Foreground="#B4FF00"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Controller IP address" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="IpTextBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TCP port" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="PortTextBox"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Agent name (binary file name)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="NameTextBox" Text="agent"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Heartbeat (seconds)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="HeartbeatTextBox" Text="10"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Output folder" Style="{StaticResource FieldLabelStyle}" Margin="0,6,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputTextBox" Grid.Column="0"/>
                    <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse..." Click="BrowseButton_Click"
                            Height="30"/>
                </Grid>

                <TextBlock x:Name="InfoText" Text="Generates a self-contained Python 3 agent script (no build required). Run it on any Linux machine with Python 3 installed."
                           FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource HeaderGlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="20,14">
                <StackPanel>
                    <TextBlock x:Name="ProgressText" Text="Ready" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="BuildProgress" Height="6" IsIndeterminate="True" Visibility="Collapsed"
                                 Margin="0,0,0,10" Foreground="{StaticResource LimeBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="Close" Width="90" Height="32" Margin="0,0,10,0"
                                Click="CloseButton_Click" Style="{StaticResource DangerButtonStyle}"/>
                        <Button x:Name="GenerateButton" Content="&#x26a1;  Generate Agent" Width="170" Height="32"
                                Click="GenerateButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Border CornerRadius="8" BorderBrush="{StaticResource WindowFrameBrush}" BorderThickness="2"
                Panel.ZIndex="9999" Grid.RowSpan="2" IsHitTestVisible="False"/>
    </Grid>
</Window>