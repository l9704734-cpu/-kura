<UserControl x:Class="Diver_RaT.CustomTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="34">
    <Border Background="{StaticResource HeaderGlassBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="/Resources/app.ico" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource LimeBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,6,0">
                <Button Style="{StaticResource WinButtonStyle}" Content="&#xE921;" ToolTip="Minimize"
                        Click="Minimize_Click"/>
                <Button Style="{StaticResource WinCloseButtonStyle}" Content="&#xE8BB;" ToolTip="Close"
                        Click="Close_Click" Margin="2,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
