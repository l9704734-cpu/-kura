<Window x:Class="Diver_RaT.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Diver_RaT"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}"
        Foreground="#E6E8EF"
        Title="Preview">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="1" ResizeBorderThickness="6"
                      CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:CustomTitleBar Grid.Row="0" Title="Preview"/>
        <Grid Grid.Row="1" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="CopyButton" Content="&#x2398;  Copy" Click="CopyButton_Click" Padding="14,5"/>
            <Button x:Name="DownloadButton" Content="&#x2b07;  Download..." Click="DownloadButton_Click" Padding="14,5" Margin="8,0,0,0"/>
            <TextBlock x:Name="MetaText" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#F00A0D09" CornerRadius="8"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
            <TextBox x:Name="ContentBox" IsReadOnly="True" TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="10"
                     TextAlignment="Left" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="Transparent" Foreground="#D6FF7A" BorderThickness="0"
                     SelectionBrush="#26324C"/>
        </Border>
        </Grid>
        <Border CornerRadius="8" BorderBrush="{StaticResource WindowFrameBrush}" BorderThickness="2"
                Panel.ZIndex="9999" Grid.RowSpan="2" IsHitTestVisible="False"/>
    </Grid>
</Window>
