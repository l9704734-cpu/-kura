<Window x:Class="Diver_RaT.PayloadCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Diver_RaT"
        Title="Payload Creator" Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource WindowBgBrush}"
        Foreground="#E6E8EF">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6ACBF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A141C12"/>
            <Setter Property="Foreground" Value="#E6E8EF"/>
            <Setter Property="BorderBrush" Value="#3DB4FF00"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#B4FF00"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="1" ResizeBorderThickness="6"
                      CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:CustomTitleBar Grid.Row="0" Title="Payload Creator"/>
        <Grid Grid.Row="1" Background="{StaticResource WindowBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource HeaderGlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,16">
                <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" CornerRadius="4"
                        Background="{StaticResource LimeBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Payload Creator" FontSize="16" FontWeight="Bold" Foreground="{StaticResource LimeBrush}"/>
                        <TextBlock Text="Build an agent .exe that connects back to this controller over TCP"
                               FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20" VerticalAlignment="Center">
                <TextBlock Text="LISTENER (CONTROLLER)" Style="{StaticResource FieldLabelStyle}" FontWeight="SemiBold" Foreground="#B4FF00"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Controller IP address" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="IpTextBox" Text="192.168.56.10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TCP port" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="PortTextBox" Text="5050"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Agent name (exe file name)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="NameTextBox" Text="client"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Heartbeat (seconds)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="HeartbeatTextBox" Text="10"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Output folder" Style="{StaticResource FieldLabelStyle}" Margin="0,6,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputTextBox" Grid.Column="0" Text="C:\payloads"/>
                    <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse..." Click="BrowseButton_Click"
                        Height="30"/>
                </Grid>

                <TextBlock Text="Application icon (optional)" Style="{StaticResource FieldLabelStyle}" Margin="0,6,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IconTextBox" Grid.Column="0" IsReadOnly="True"
                         ToolTip="PNG, JPG, JPEG, ICO or BMP - becomes the payload exe's icon"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Image x:Name="IconPreview" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Button x:Name="BrowseIconButton" Content="Browse..." Click="BrowseIconButton_Click" Height="30" Padding="10,0"/>
                        <Button x:Name="ClearIconButton" Content="Default" Click="ClearIconButton_Click" Height="30" Padding="10,0" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="RunAtStartupCheck"
                      Content="Run at Windows startup (auto-registers in the registry for immediate reconnection after a reboot)"
                      Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" VerticalAlignment="Center"/>

                <TextBlock x:Name="InfoText" Text="The agent registers, heartbeats, then waits for commands." 
                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource HeaderGlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,14" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="ProgressText" Text="Ready" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="BuildProgress" Height="6" IsIndeterminate="True" Visibility="Collapsed"
                             Margin="0,0,0,10" Foreground="{StaticResource LimeBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="Close" Width="90" Height="32" Margin="0,0,10,0"
                            Click="CloseButton_Click" Style="{StaticResource DangerButtonStyle}"/>
                        <Button x:Name="GenerateButton" Content="&#x26a1;  Generate Payload" Width="170" Height="32"
                            Click="GenerateButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Border CornerRadius="8" BorderBrush="{StaticResource WindowFrameBrush}" BorderThickness="2"
                Panel.ZIndex="9999" Grid.RowSpan="2" IsHitTestVisible="False"/>
    </Grid>
</Window>
