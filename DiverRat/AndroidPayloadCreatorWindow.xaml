<Window x:Class="Diver_RaT.AndroidPayloadCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Diver_RaT"
        Title="Android Payload Creator" Height="700" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource WindowBgBrush}"
        Foreground="#E6E8EF">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6ACBF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="1" ResizeBorderThickness="6"
                      CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:CustomTitleBar Grid.Row="0" Title="Android Payload Creator"/>
        <Grid Grid.Row="1" Background="{StaticResource WindowBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource HeaderGlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" CornerRadius="4"
                            Background="{StaticResource LimeBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Android Payload Creator" FontSize="16" FontWeight="Bold" Foreground="{StaticResource LimeBrush}"/>
                        <TextBlock Text="Build an Android APK agent that connects back to this controller over TCP"
                                   FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,18" VerticalAlignment="Top">
                <TextBlock Text="LISTENER (CONTROLLER)" Style="{StaticResource FieldLabelStyle}" FontWeight="SemiBold" Foreground="#B4FF00"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Controller IP address" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="IpTextBox" Text="192.168.1.222"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TCP port" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="PortTextBox" Text="5051"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Output folder" Style="{StaticResource FieldLabelStyle}" Margin="0,6,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputTextBox" Grid.Column="0" Text="C:\payloads"/>
                    <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse..." Click="BrowseButton_Click"
                            Height="30"/>
                </Grid>

                <TextBlock Text="App icon (optional)" Style="{StaticResource FieldLabelStyle}" Margin="0,6,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IconTextBox" Grid.Column="0" IsReadOnly="True"
                             ToolTip="PNG, JPG, JPEG, ICO or BMP - becomes the APK launcher icon"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Image x:Name="IconPreview" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Button x:Name="BrowseIconButton" Content="Browse..." Click="BrowseIconButton_Click" Height="30" Padding="10,0"/>
                        <Button x:Name="ClearIconButton" Content="Default" Click="ClearIconButton_Click" Height="30" Padding="10,0" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="APPLICATION" Style="{StaticResource FieldLabelStyle}" FontWeight="SemiBold" Foreground="#B4FF00" Margin="0,10,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="App name (shown under the icon)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="AppNameTextBox" Text="Diver Agent"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="App version" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="VersionTextBox" Text="1.0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Package name" Style="{StaticResource FieldLabelStyle}" Margin="0,6,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PackageTextBox" Grid.Column="0" Text="com.diverrat.agent"
                             ToolTip="Unique application ID, e.g. com.example.app"/>
                    <Button x:Name="RandomPackageButton" Grid.Column="2" Content="Random"
                            Click="RandomPackageButton_Click" Height="30" Padding="12,0"/>
                </Grid>

                <CheckBox x:Name="LauncherIconCheck" Content="Show app icon in the launcher / apps list"
                          IsChecked="True" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                <TextBlock Text="Uncheck to hide the app icon - it can still be started with: adb shell am start -n &lt;package&gt;/.PermissionActivity"
                           Style="{StaticResource FieldLabelStyle}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Margin="24,2,0,0"/>

                <TextBlock x:Name="InfoText" Text="The APK installs as 'Diver Agent'. On launch it starts a foreground service that connects to the controller, registers, and waits for commands. Requires Android 7.0+ (API 24)."
                           FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource HeaderGlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="20,14">
                <StackPanel>
                    <TextBlock x:Name="ProgressText" Text="Ready" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="BuildProgress" Height="6" IsIndeterminate="True" Visibility="Collapsed"
                                 Margin="0,0,0,10" Foreground="{StaticResource LimeBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="Close" Width="90" Height="32" Margin="0,0,10,0"
                                Click="CloseButton_Click" Style="{StaticResource DangerButtonStyle}"/>
                        <Button x:Name="GenerateButton" Content="&#x1f4e6;  Generate APK" Width="170" Height="32"
                                Click="GenerateButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Border CornerRadius="8" BorderBrush="{StaticResource WindowFrameBrush}" BorderThickness="2"
                Panel.ZIndex="9999" Grid.RowSpan="2" IsHitTestVisible="False"/>
    </Grid>
</Window>