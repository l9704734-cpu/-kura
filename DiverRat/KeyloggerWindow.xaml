<Window x:Class="Diver_RaT.KeyloggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Diver_RaT"
        WindowStyle="None"
        ResizeMode="CanResize"
        Title="Keylogger" Height="620" Width="860"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}"
        Foreground="#E6E8EF"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="1" ResizeBorderThickness="6"
                      CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:CustomTitleBar Grid.Row="0" Title="Keylogger"/>
        <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource LimeBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="KEYLOGGER" FontSize="15" FontWeight="Bold" Foreground="{StaticResource LimeBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TargetText" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="10,2,0,0" VerticalAlignment="Center"/>
            <Border Grid.Column="1" CornerRadius="6" Padding="10,4" Margin="14,0,0,0"
                    Background="#1F141C12" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{StaticResource OfflineBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StateText" Text="Stopped" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelGlassBrush}" CornerRadius="8"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Padding="8,6"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StartButton" Content="&#x25b6;  Start" Click="StartButton_Click" Padding="12,0" Height="30"/>
                <Button x:Name="StopButton" Content="&#x25a0;  Stop" Click="StopButton_Click" Padding="12,0" Height="30" Margin="8,0,0,0" IsEnabled="False"/>
                <Button x:Name="GetButton" Content="&#x21bb;  Get Log Now" Click="GetButton_Click" Padding="12,0" Height="30" Margin="8,0,0,0"/>
                <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" Padding="12,0" Height="30" Margin="8,0,0,0"/>

                <Border Width="1" Background="{StaticResource GlassBorderBrush}" Margin="14,4" VerticalAlignment="Stretch"/>

                <CheckBox x:Name="AutoRefreshCheck" Content="Auto-refresh" IsChecked="True"
                          Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed"
                          VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#D6FF7A"/>
                <TextBlock Text="every" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="IntervalBox" Text="10" Width="42" TextAlignment="Center"
                         TextChanged="IntervalBox_TextChanged" VerticalContentAlignment="Center"
                         Padding="2,0" Height="28" ToolTip="Seconds between log fetches"/>
                <TextBlock Text="sec" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelGlassBrush}" CornerRadius="8"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,8,12,6">
                    <TextBlock Text="CAPTURED INPUT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource LimeBrush}"/>
                    <TextBlock x:Name="CharCountText" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Padding="12"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" Background="#F00A0D09"/>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,8,0,0" FontSize="12"
                   Foreground="{StaticResource MutedBrush}"/>
        </Grid>
        <Border CornerRadius="8" BorderBrush="{StaticResource WindowFrameBrush}" BorderThickness="2"
                Panel.ZIndex="9999" Grid.RowSpan="2" IsHitTestVisible="False"/>
    </Grid>
</Window>
